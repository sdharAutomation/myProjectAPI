# Copy this file to .env and fill in values as needed

# Base API URL (required for most tests)
API_BASE_URL=https://api.example.com

# Paths (relative to API_BASE_URL unless absolute)
API_PROTECTED_PATH=/v1/me
API_SCOPED_PATH=/v1/admin
API_RATE_LIMITED_PATH=/v1/search
API_PUBLIC_PATH=/v1/public
API_BAD_REQUEST_PATH=/v1/items
# If unset, a random non-existent path will be generated for 404 testing
# API_NOT_FOUND_PATH=/definitely-not-found

# Tokens
API_VALID_BEARER_TOKEN=
API_INVALID_BEARER_TOKEN=invalid
API_INSUFFICIENT_SCOPE_BEARER_TOKEN=
# Either admin or any sufficiently authorized token
API_ADMIN_BEARER_TOKEN=
# Alternative key name supported
# API_AUTHORIZED_BEARER_TOKEN=

# Behavior flags and timeouts
API_ERRORS_ARE_JSON=1
API_REQUEST_TIMEOUT_SECONDS=10
API_RATELIMIT_BURST_GUESS=20